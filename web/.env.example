# Supabase Auth (públicos por design; usados pelo SDK no browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional, mas recomendado no Pipinho pessoal.
# Mesmo que outra conta exista no projeto Supabase, só estes e-mails entram no app.
# Ex.: PIPINHO_ALLOWED_EMAILS=voce@gmail.com,outro@email.com
PIPINHO_ALLOWED_EMAILS=

# Backend Fastify. SOMENTE server-side no Next/Vercel.
FINANCIAL_API_URL=http://localhost:3333
FINANCIAL_API_TOKEN=

# C11.3 — memória persistente do chat. 0 desativa expiração automática.
# Valores positivos são limitados entre 30 e 3650 dias.
PIPINHO_CHAT_RETENTION_DAYS=365

# Ciclo 12 — Google Calendar (server-side only)
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Local: http://localhost:3000/api/pipinho/calendar/callback
# Vercel: https://SEU-DOMINIO/api/pipinho/calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/pipinho/calendar/callback
# 32 bytes base64 ou 64 hex. Gerar:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
PIPINHO_CALENDAR_PAST_DAYS=30
PIPINHO_CALENDAR_FUTURE_DAYS=90
PIPINHO_CALENDAR_AUTO_SYNC_MINUTES=15
