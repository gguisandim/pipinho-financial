PORT=3333
GROQ_API_KEY=

# Ciclos anteriores / compatibilidade
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STRUCTURED_MODEL=openai/gpt-oss-20b
GROQ_TOOL_MODEL=openai/gpt-oss-20b

# Síntese sem tools e agente do Ciclo 4.
# Em 16/08/2026, llama-3.3-70b-versatile chegou à data oficial de shutdown
# no free/developer tier da Groq, então o laboratório migra para GPT-OSS 20B.
GROQ_FINAL_MODEL=openai/gpt-oss-20b
GROQ_AGENT_MODEL=openai/gpt-oss-20b

# Guardrails do agent loop
GROQ_AGENT_MAX_ITERATIONS=5
GROQ_AGENT_MAX_TOOL_CALLS=12
