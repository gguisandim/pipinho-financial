PORT=3333

# Groq — provider principal do laboratório
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STRUCTURED_MODEL=openai/gpt-oss-20b
GROQ_TOOL_MODEL=openai/gpt-oss-20b
GROQ_FINAL_MODEL=openai/gpt-oss-20b
GROQ_AGENT_MODEL=openai/gpt-oss-20b

# OpenRouter — segundo provider cloud do Ciclo 5B.
# Crie uma API key no painel do OpenRouter. O router openrouter/free seleciona
# modelos gratuitos compatíveis com os recursos pedidos (inclusive tools).
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=openrouter/free
OPENROUTER_FINAL_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=120000

AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=12
