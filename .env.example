PORT=3333

# Groq — provider principal do laboratório
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STRUCTURED_MODEL=openai/gpt-oss-20b
GROQ_TOOL_MODEL=openai/gpt-oss-20b
GROQ_FINAL_MODEL=openai/gpt-oss-20b
GROQ_AGENT_MODEL=openai/gpt-oss-20b

# OpenRouter — segundo provider cloud do Ciclo 5B.
# Crie uma API key no painel do OpenRouter. O router openrouter/free seleciona
# modelos gratuitos compatíveis com os recursos pedidos (inclusive tools).
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=openrouter/free
OPENROUTER_FINAL_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=120000

AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=12

# Pluggy — Ciclo 6.1 (somente backend)
# Copie Client ID e Client Secret da sua aplicação no Pluggy Dashboard.
# Nunca prefixe essas variáveis com NEXT_PUBLIC_ e nunca envie o secret ao browser.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_AUTH_TIMEOUT_MS=15000
# API Key da Pluggy: validade documentada de 2 horas.
PLUGGY_API_KEY_TTL_SECONDS=7200
# Renova 5 minutos antes da validade estimada.
PLUGGY_API_KEY_REFRESH_SKEW_SECONDS=300

# Pluggy — Ciclo 6.2 (Items já autorizados no MeuPluggy/Demo)
# A API não oferece listagem de Items existentes; persista os itemIds criados.
PLUGGY_ITEM_IDS=
# Opcional, apenas para rotular localmente os IDs na mesma ordem.
PLUGGY_ITEM_LABELS=Nubank,Neon,PicPay
PLUGGY_DATA_TIMEOUT_MS=30000
# Converte timestamps UTC da Pluggy para uma data civil brasileira.
FINANCE_TIME_ZONE=America/Sao_Paulo
# Ciclo 6.4: valores financeiros ficam ocultos no terminal por padrão.
FINANCE_ANALYSIS_SHOW_AMOUNTS=false
# Vazio = todo o histórico que a conexão disponibilizar (normalmente até 12 meses).
PLUGGY_TRANSACTION_DATE_FROM=
PLUGGY_TRANSACTION_DATE_TO=
# /v2/transactions usa cursor e páginas de até 500 registros.
PLUGGY_MAX_TRANSACTION_PAGES=25
# Por segurança, valores e descrições detalhadas ficam ocultos no discovery.
PLUGGY_DISCOVERY_SHOW_AMOUNTS=false
PLUGGY_DISCOVERY_SHOW_SAMPLES=false

# Ciclo 8 — Data Enrichment
# Despesas `other` repetidas podem ser classificadas via Structured Outputs.
# O backend envia somente descrições sanitizadas, sem valores, accountId/itemId ou datas.
ENRICHMENT_USE_LLM=true
ENRICHMENT_SHOW_DESCRIPTIONS=false
ENRICHMENT_MIN_OCCURRENCES=2
ENRICHMENT_MAX_EXPENSE_GROUPS=12
ENRICHMENT_MAX_INFLOW_GROUPS=12
