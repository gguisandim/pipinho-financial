PORT=3333

# Groq - usado pelo assistente e pelos insights do dashboard
GROQ_API_KEY=
GROQ_AGENT_MODEL=openai/gpt-oss-20b
GROQ_FINAL_MODEL=openai/gpt-oss-20b
GROQ_STRUCTURED_MODEL=openai/gpt-oss-20b
GROQ_REQUEST_RETRIES=2
GROQ_RETRY_BASE_MS=750

# Pluggy - somente backend
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=
PLUGGY_ITEM_LABELS=Nubank,Neon,PicPay
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_AUTH_TIMEOUT_MS=15000
PLUGGY_DATA_TIMEOUT_MS=30000
PLUGGY_REQUEST_RETRIES=2
PLUGGY_RETRY_BASE_MS=500
PLUGGY_API_KEY_TTL_SECONDS=7200
PLUGGY_API_KEY_REFRESH_SKEW_SECONDS=300
PLUGGY_MAX_TRANSACTION_PAGES=25

FINANCE_TIME_ZONE=America/Sao_Paulo

# API protegida. Não exponha este token no browser.
DASHBOARD_REQUIRE_AUTH=true
DASHBOARD_API_TOKEN=
DASHBOARD_CACHE_TTL_MS=300000
DASHBOARD_AI_CACHE_TTL_MS=60000
DASHBOARD_AI_MAX_CARDS=4
DASHBOARD_AI_MAX_COMPLETION_TOKENS=1400

AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=12
